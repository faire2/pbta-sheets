# Database (provisioned by Vercel marketplace Neon integration; pull via `vercel env pull .env.local`)
DATABASE_URL=

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth — create credentials in Google Cloud Console
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<production-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js base URL — only set explicitly when behind a proxy or non-Vercel host
AUTH_URL=http://localhost:3000
